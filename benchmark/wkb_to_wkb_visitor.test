create table t1 as select wkb_from_blob(geometry) as geometry from '${DATASET}';
.mode trash
WITH cte AS (select st_aswkb_visitor(a.geometry) from t1 a) SELECT ANY_VALUE(COLUMNS(*)) FROM cte;
.timer on
