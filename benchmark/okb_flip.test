create table t1 as select okb_from_blob(geometry) as geometry from '${DATASET}';
.mode trash
WITH cte AS (SELECT st_flip(a.geometry) from t1 a) SELECT ANY_VALUE(COLUMNS(*)) FROM cte;
.timer on

