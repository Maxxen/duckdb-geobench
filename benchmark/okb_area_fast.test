create table t1 as select okb_from_blob(geometry) as geometry from '${DATASET}';
.mode trash
.timer on

WITH cte AS (SELECT st_area_non_recursive(a.geometry) from t1 a) SELECT ANY_VALUE(COLUMNS(*)) FROM cte;
