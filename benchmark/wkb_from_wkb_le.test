create table t1 as select wkb_to_blob(wkb_from_blob(geometry)) as geometry from '${DATASET}';
.mode trash
WITH cte AS (select wkb_from_blob(geometry) as geometry from t1) SELECT ANY_VALUE(COLUMNS(*)) FROM cte;
.timer on
