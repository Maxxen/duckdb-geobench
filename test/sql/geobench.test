# name: test/sql/geobench.test
# description: test geobench extension
# group: [sql]

# Before we load the extension, this will fail
statement error
SELECT geobench('Sam');
----
Catalog Error: Scalar Function with name geobench does not exist!

# Require statement will ensure this test is run with this extension loaded
require geobench

# Confirm the extension works
query I
SELECT geobench('Sam');
----
Geobench Sam 🐥

query I
SELECT geobench_openssl_version('Michael') ILIKE 'Geobench Michael, my linked OpenSSL version is OpenSSL%';
----
true
